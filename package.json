{
  "name": "mcp-starter",
  "version": "1.0.0",
  "description": "Minimal MCP server starter template — lean by design",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "start:http": "node --env-file=.env dist/index.js --http",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:http": "tsx --env-file=.env src/index.ts --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "author": "Software Savants <hello@software-savants.com>",
  "license": "MIT",
  "homepage": "https://www.software-savants.com/en/mcp-development",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoftwareSavants/mcp-starter"
  }
}
